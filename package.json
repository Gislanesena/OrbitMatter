{
  "name": "orbit-matter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=.env scripts/dev.mjs",
    "verificar": "tsc --noEmit",
    "montar": "esbuild app/entrada-navegador.ts --bundle --format=iife --global-name=AtlasIA --platform=browser --target=es2018 --outfile=dist/atlas-ia.js",
    "pregerar": "esbuild scripts/pregerar-missoes.ts --bundle --platform=node --format=cjs --outfile=dist/pregerar.cjs && node dist/pregerar.cjs",
    "testar": "node --experimental-strip-types scripts/testar-simulacao.ts",
    "testar:chat": "node --experimental-strip-types scripts/testar-chat.mjs",
    "testar:minijogo": "node scripts/testar-minijogo.mjs",
    "testar:minijogo-fragmentos": "node --experimental-strip-types scripts/testar-minijogo-fragmentos.mjs",
    "calibrar": "node --experimental-strip-types scripts/calibrar-cenarios.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "serve-handler": "^6.1.8",
    "typescript": "^5.8.3"
  }
}
